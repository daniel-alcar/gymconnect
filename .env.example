# ============================================================
#  GymConnect - Modelo de variáveis de ambiente
# ============================================================
#  COMO USAR:
#    1. Copie este arquivo para ".env"  (na raiz do projeto):
#         Windows (PowerShell):  Copy-Item .env.example .env
#         Linux/macOS:           cp .env.example .env
#    2. Preencha os valores (principalmente a "keigemini").
#    3. NÃO suba o .env para o Git (já está no .gitignore).
# ============================================================

# ---------------- Banco de dados MySQL ----------------
MYSQL_ROOT_PASSWORD=dUOCXi5bVhN5JEpG7wUim72xolJZbYjf
MYSQL_DATABASE=teste_gymconnect
MYSQL_USER=gymconnect
MYSQL_PASSWORD=bmavKH4zHP03msP2omj6aZyX5Sq90Jn3

# ---------------- Segurança (JWT) ----------------
# Troque por uma chave secreta forte em produção.
JWT_SECRET=my-secret-key-change-in-production

# ---------------- Perfil do Spring Boot ----------------
# "prod" usa as variáveis acima para conectar ao banco.
SPRING_PROFILES_ACTIVE=prod

# ---------------- Chave da API do Gemini (IA) ----------------
# Obtenha em: https://aistudio.google.com/app/apikey  (formato AIza...)
# O backend lê esta variável pela propriedade gemini.api-key=${keigemini}
# Sem ela, a tela "Chat IA" retorna erro 502.
keigemini=SUA_CHAVE_AQUI

# Modelo do Gemini (opcional; padrão gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
